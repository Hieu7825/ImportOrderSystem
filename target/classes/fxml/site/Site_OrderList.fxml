<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.controller.site.Site_OrderListController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item" maxWidth="Infinity" onAction="#goDashboard"/>
            <Button text="ℹ  Thông tin site" styleClass="nav-item" maxWidth="Infinity" onAction="#goProfile"/>
            <Button text="📋  Mặt hàng KD" styleClass="nav-item" maxWidth="Infinity" onAction="#goCatalog"/>
            <Button text="📦  Tồn kho" styleClass="nav-item" maxWidth="Infinity" onAction="#goStock"/>
            <Button text="🛒  Đơn hàng" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label fx:id="lblSiteCode" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 32;">
            <Label text="Đơn hàng của site"
                   style="-fx-text-fill: #E8ECF5; -fx-font-size: 22px; -fx-font-weight: 700;"/>
            <TableView fx:id="tblOrders" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="MÃ ĐƠN" prefWidth="220"/>
                    <TableColumn fx:id="colBatch" text="BATCH" prefWidth="180"/>
                    <TableColumn fx:id="colMeans" text="VẬN CHUYỂN" prefWidth="120"/>
                    <TableColumn fx:id="colArrival" text="DỰ KIẾN VỀ" prefWidth="130"/>
                    <TableColumn fx:id="colConfirmed" text="ĐÃ XÁC NHẬN" prefWidth="120"/>
                    <TableColumn fx:id="colStatus" text="TRẠNG THÁI" prefWidth="140"/>
                    <TableColumn fx:id="colActions" text="THAO TÁC" prefWidth="200"/>
                </columns>
                <placeholder>
                    <Label text="Chưa có đơn hàng nào" style="-fx-text-fill: #4A5368;"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>
</BorderPane>