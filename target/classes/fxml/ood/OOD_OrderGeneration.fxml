<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.uc4_create_request.OOD_OrderGenerationController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="← Quay lại" styleClass="nav-item" maxWidth="Infinity" onAction="#goBack"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="ĐẶT HÀNG QUỐC TẾ" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 32;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Quay lại" styleClass="btn-ghost" onAction="#goBack"/>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Tối ưu hóa &amp; Sinh đơn hàng"
                           style="-fx-text-fill: #E8ECF5; -fx-font-size: 20px; -fx-font-weight: 700;"/>
                    <Label fx:id="lblBatchId" style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>

            <!-- Plan navigation -->
            <HBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="16">
                <Button text="← Phương án trước" styleClass="btn-ghost"
                        onAction="#handlePrevPlan"/>
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label fx:id="lblPlanIndex"
                           style="-fx-text-fill: #E8ECF5; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                    <!-- Label tên chiến lược -->
                    <Label fx:id="lblPlanLabel"
                           style="-fx-text-fill: #4F6EF7; -fx-font-size: 12px; -fx-font-weight: 500;"/>
                </VBox>
                <Button text="Phương án tiếp →" styleClass="btn-ghost"
                        onAction="#handleNextPlan"/>
            </HBox>

            <!-- Insufficient items warning -->
            <VBox fx:id="vboxWarning" spacing="8" visible="false" managed="false"
                  style="-fx-background-color: rgba(239,68,68,0.08);
                         -fx-border-color: rgba(239,68,68,0.3);
                         -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12;">
                <Label text="⚠ Không thể đáp ứng đủ các mặt hàng sau:"
                       style="-fx-text-fill: #EF4444; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                <Label fx:id="lblInsufficientItems"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 12px;" wrapText="true"/>
            </VBox>

            <!-- Site orders preview -->
            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Label text="Đơn hàng sẽ sinh:"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                <TableView fx:id="tblSiteOrders" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSite"    text="SITE"        prefWidth="100"/>
                        <TableColumn fx:id="colMeans"   text="VẬN CHUYỂN"  prefWidth="120"/>
                        <TableColumn fx:id="colArrival" text="DỰ KIẾN VỀ"  prefWidth="140"/>
                        <TableColumn fx:id="colItems"   text="MẶT HÀNG"    prefWidth="400"/>
                    </columns>
                    <placeholder>
                        <Label text="Đang tính phương án..." style="-fx-text-fill: #4A5368;"/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Confirm button -->
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button text="Hủy" styleClass="btn-ghost" onAction="#goBack"/>
                <Button fx:id="btnConfirm" text="✓ Xác nhận &amp; Sinh đơn hàng"
                        styleClass="btn-primary" onAction="#handleConfirm" disable="true"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>
