<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.uc6_process_request.OOD_OrderRequestListController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item" maxWidth="Infinity" onAction="#goDashboard"/>
            <Button text="📋  Yêu cầu nhập hàng" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
            <Button text="📦  Đơn hàng" styleClass="nav-item" maxWidth="Infinity" onAction="#goSiteOrders"/>
            <Button text="⚠  Yêu cầu hủy" styleClass="nav-item" maxWidth="Infinity" onAction="#goCancelRequests"/>
            <Button text="🏭  Quản lý Site" styleClass="nav-item" maxWidth="Infinity" onAction="#goSites"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="ĐẶT HÀNG QUỐC TẾ" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 32;">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Yêu cầu nhập hàng"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 22px; -fx-font-weight: 700;"
                       HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12">
                <ComboBox fx:id="cmbStatus" promptText="Tất cả trạng thái"
                          style="-fx-background-color: #1C2030; -fx-border-color: #252A3A;
                                 -fx-border-radius: 8px; -fx-background-radius: 8px;
                                 -fx-text-fill: #E8ECF5;" prefWidth="200"
                          onAction="#handleFilter"/>
                <TextField fx:id="txtSearch" promptText="Tìm batch ID, người tạo..."
                           styleClass="text-field" prefWidth="280"
                           onKeyReleased="#handleFilter"/>
            </HBox>
            <TableView fx:id="tblRequests" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colBatchId"    text="BATCH ID"        prefWidth="190"/>
                    <TableColumn fx:id="colCreatedBy"  text="NGƯỜI TẠO"       prefWidth="140"/>
                    <TableColumn fx:id="colItems"      text="SỐ MẶT HÀNG"    prefWidth="120"/>
                    <!-- displayStatus thay vì status gốc -->
                    <TableColumn fx:id="colStatus"     text="TRẠNG THÁI"      prefWidth="130"/>
                    <!-- Số lần xử lý -->
                    <TableColumn fx:id="colSubBatches" text="LẦN XỬ LÝ"      prefWidth="120"/>
                    <TableColumn fx:id="colCreatedAt"  text="NGÀY TẠO"        prefWidth="150"/>
                    <TableColumn fx:id="colActions"    text="THAO TÁC"        prefWidth="180"/>
                </columns>
                <placeholder>
                    <Label text="Không có yêu cầu nào" style="-fx-text-fill: #4A5368;"/>
                </placeholder>
            </TableView>
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 8 0 0 0;">
                <Button text="◀ Trang trước" styleClass="btn-ghost" onAction="#handlePrevPage"/>
                <Label fx:id="lblPageInfo" style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                <Button text="Trang sau ▶" styleClass="btn-ghost" onAction="#handleNextPage"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
