<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.importorder.controller.ChangePasswordController"
           stylesheets="@../css/global.css"
           style="-fx-background-color: rgba(0,0,0,0.5);">

    <VBox alignment="CENTER" maxWidth="480"
          style="-fx-background-color: #13161E; -fx-border-color: #252A3A;
                 -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 32;">

        <Label text="Đổi mật khẩu"
               style="-fx-text-fill: #E8ECF5; -fx-font-size: 20px; -fx-font-weight: 700;
                      -fx-padding: 0 0 20 0;"/>

        <VBox spacing="16">
            <VBox spacing="6">
                <Label text="MẬT KHẨU CŨ *" styleClass="form-label"/>
                <PasswordField fx:id="txtOldPassword" styleClass="text-field"
                               promptText="Nhập mật khẩu hiện tại..."/>
                <Label fx:id="lblOldErr" styleClass="form-error" visible="false" managed="false"/>
            </VBox>
            <VBox spacing="6">
                <Label text="MẬT KHẨU MỚI *" styleClass="form-label"/>
                <PasswordField fx:id="txtNewPassword" styleClass="text-field"
                               promptText="Tối thiểu 8 ký tự, có chữ và số..."/>
                <Label fx:id="lblNewErr" styleClass="form-error" visible="false" managed="false"/>
            </VBox>
            <VBox spacing="6">
                <Label text="XÁC NHẬN MẬT KHẨU MỚI *" styleClass="form-label"/>
                <PasswordField fx:id="txtConfirm" styleClass="text-field"
                               promptText="Nhập lại mật khẩu mới..."/>
                <Label fx:id="lblConfirmErr" styleClass="form-error" visible="false" managed="false"/>
            </VBox>

            <Label fx:id="lblError" styleClass="form-error" wrapText="true"
                   visible="false" managed="false"
                   style="-fx-background-color: rgba(239,68,68,0.1);
                          -fx-background-radius: 6px; -fx-padding: 8 12;"/>

            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                <Button text="Hủy" styleClass="btn-ghost" onAction="#handleClose"/>
                <Button text="Đổi mật khẩu" styleClass="btn-primary" onAction="#handleSave"
                        defaultButton="true"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>