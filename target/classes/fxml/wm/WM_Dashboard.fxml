<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.controller.wm.WM_DashboardController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
            <Button text="🔍  Kiểm kê hàng" styleClass="nav-item" maxWidth="Infinity" onAction="#goInspection"/>
            <Button text="📦  Danh sách đơn hàng" styleClass="nav-item" maxWidth="Infinity" onAction="#goOrderList"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="QUẢN LÝ KHO" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
            <Button text="🔑 Đổi mật khẩu" styleClass="btn-ghost"  maxWidth="Infinity" onAction="#handleChangePassword" style="-fx-font-size: 12px;"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="24" style="-fx-padding: 32;">
            <Label text="Tổng quan Kho hàng"
                   style="-fx-text-fill: #E8ECF5; -fx-font-size: 22px; -fx-font-weight: 700;"/>
            <HBox spacing="16">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Chờ kiểm hàng" styleClass="stat-card-label"/>
                    <Label fx:id="lblPending" text="0" styleClass="stat-card-value" style="-fx-text-fill: #F59E0B;"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Nhận một phần" styleClass="stat-card-label"/>
                    <Label fx:id="lblPartial" text="0" styleClass="stat-card-value" style="-fx-text-fill: #38BDF8;"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Sai lệch chưa xử lý" styleClass="stat-card-label"/>
                    <Label fx:id="lblDiscrepancy" text="0" styleClass="stat-card-value" style="-fx-text-fill: #EF4444;"/>
                </VBox>
            </HBox>
            <HBox spacing="16">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="12"
                      style="-fx-cursor: hand;" onMouseClicked="#goInspection">
                    <Label text="🔍  Kiểm kê hàng về"
                           style="-fx-text-fill: #E8ECF5; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                    <Label text="Xác nhận và đối chiếu hàng nhận về"
                           style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="12"
                      style="-fx-cursor: hand;" onMouseClicked="#goOrderList">
                    <Label text="📦  Tra cứu đơn hàng"
                           style="-fx-text-fill: #E8ECF5; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                    <Label text="Xem toàn bộ lịch sử đơn hàng"
                           style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>