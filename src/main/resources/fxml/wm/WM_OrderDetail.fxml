<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.uc1_confirm_import.WM_OrderDetailController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item" maxWidth="Infinity" onAction="#goDashboard"/>
            <Button text="✓  Xác nhận nhập kho" styleClass="nav-item" maxWidth="Infinity" onAction="#goConfirmReceived"/>
            <Button text="🔍  Kiểm kê hàng" styleClass="nav-item" maxWidth="Infinity" onAction="#goInspection"/>
            <Button text="📦  Danh sách đơn hàng" styleClass="nav-item, nav-item-active" maxWidth="Infinity" onAction="#goOrderList"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="QUẢN LÝ KHO" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 32;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Quay lại" styleClass="btn-ghost" onAction="#goOrderList"/>
                <Label text="Chi tiết đơn hàng"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 20px; -fx-font-weight: 700;"/>
            </HBox>

            <!-- Info -->
            <VBox styleClass="stat-card" spacing="12">
                <HBox spacing="32">
                    <VBox spacing="4">
                        <Label text="MÃ ĐƠN" styleClass="form-label"/>
                        <Label fx:id="lblSiteOrderId" style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="SITE" styleClass="form-label"/>
                        <Label fx:id="lblSite" style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="VẬN CHUYỂN" styleClass="form-label"/>
                        <Label fx:id="lblMeans" style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="TRẠNG THÁI" styleClass="form-label"/>
                        <Label fx:id="lblStatus" style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Items -->
            <VBox spacing="8">
                <Label text="Mặt hàng trong đơn"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                <TableView fx:id="tblItems" styleClass="table-view" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colCode" text="MÃ HÀNG" prefWidth="130"/>
                        <TableColumn fx:id="colName" text="TÊN HÀNG" prefWidth="280"/>
                        <TableColumn fx:id="colQty" text="SỐ LƯỢNG ĐẶT" prefWidth="130"/>
                        <TableColumn fx:id="colUnit" text="ĐƠN VỊ" prefWidth="100"/>
                        <TableColumn fx:id="colItemStatus" text="TRẠNG THÁI" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Discrepancies -->
            <VBox fx:id="vboxDiscrepancy" spacing="8" visible="false" managed="false">
                <Label text="⚠ Sai lệch khi kiểm hàng"
                       style="-fx-text-fill: #F59E0B; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                <TableView fx:id="tblDiscrepancy" styleClass="table-view" prefHeight="180">
                    <columns>
                        <TableColumn fx:id="colDCode" text="MÃ HÀNG" prefWidth="120"/>
                        <TableColumn fx:id="colDExpected" text="ĐẶT" prefWidth="80"/>
                        <TableColumn fx:id="colDActual" text="THỰC NHẬN" prefWidth="100"/>
                        <TableColumn fx:id="colDError" text="MÃ LỖI" prefWidth="120"/>
                        <TableColumn fx:id="colDDesc" text="MÔ TẢ" prefWidth="280"/>
                        <TableColumn fx:id="colDRecordedBy" text="GHI BỞI" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>