<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.controller.sd.SD_OrderRequestDetailController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item" maxWidth="Infinity" onAction="#goDashboard"/>
            <Button text="📋  Yêu cầu nhập hàng" styleClass="nav-item, nav-item-active"
                    maxWidth="Infinity" onAction="#goBack"/>
            <Button text="📦  Danh sách mặt hàng" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#goMerchandise"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="BỘ PHẬN BÁN HÀNG" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 32;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Quay lại" styleClass="btn-ghost" onAction="#goBack"/>
                <Label text="Chi tiết yêu cầu nhập hàng"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 20px; -fx-font-weight: 700;"
                       HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEdit" text="✏ Sửa" styleClass="btn-ghost"
                        onAction="#handleEdit" visible="false" managed="false"/>
                <Button fx:id="btnCancel" text="🗑 Hủy yêu cầu" styleClass="btn-danger"
                        onAction="#handleCancel" visible="false" managed="false"/>
            </HBox>

            <!-- Info Card -->
            <VBox styleClass="stat-card" spacing="16">
                <HBox spacing="32">
                    <VBox spacing="4">
                        <Label text="BATCH ID" styleClass="form-label"/>
                        <Label fx:id="lblBatchId"
                               style="-fx-text-fill: #E8ECF5; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="TRẠNG THÁI" styleClass="form-label"/>
                        <Label fx:id="lblStatus"
                               style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="NGƯỜI TẠO" styleClass="form-label"/>
                        <Label fx:id="lblCreatedBy" style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="NGÀY TẠO" styleClass="form-label"/>
                        <Label fx:id="lblCreatedAt" style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Cancel info (chỉ hiện khi CANCELLED) -->
                <VBox fx:id="vboxCancelInfo" spacing="4" visible="false" managed="false"
                      style="-fx-background-color: rgba(239,68,68,0.08); -fx-background-radius: 8px; -fx-padding: 12;">
                    <Label text="THÔNG TIN HỦY" styleClass="form-label"/>
                    <HBox spacing="24">
                        <Label fx:id="lblCancelledBy" style="-fx-text-fill: #EF4444; -fx-font-size: 12px;"/>
                        <Label fx:id="lblCancelledAt" style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                    </HBox>
                    <Label fx:id="lblCancelReason"
                           style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;" wrapText="true"/>
                </VBox>
            </VBox>

            <!-- Items Table -->
            <VBox spacing="8">
                <Label text="Danh sách mặt hàng"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                <TableView fx:id="tblItems" styleClass="table-view" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colNo" text="STT" prefWidth="50"/>
                        <TableColumn fx:id="colCode" text="MÃ HÀNG" prefWidth="120"/>
                        <TableColumn fx:id="colName" text="TÊN HÀNG" prefWidth="280"/>
                        <TableColumn fx:id="colQty" text="SỐ LƯỢNG" prefWidth="100"/>
                        <TableColumn fx:id="colUnit" text="ĐƠN VỊ" prefWidth="100"/>
                        <TableColumn fx:id="colDate" text="NGÀY NHẬN M.MUỐN" prefWidth="170"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>