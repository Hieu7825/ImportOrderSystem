<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.uc2_edit_order.OOD_SiteOrderEditController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item" maxWidth="Infinity" onAction="#goDashboard"/>
            <Button text="📦  Đơn hàng" styleClass="nav-item, nav-item-active" maxWidth="Infinity" onAction="#goSiteOrders"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="24" style="-fx-padding: 32;" maxWidth="700">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Quay lại" styleClass="btn-ghost" onAction="#goSiteOrders"/>
                <Label text="Sửa đơn hàng"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 20px; -fx-font-weight: 700;"/>
            </HBox>

            <VBox styleClass="stat-card" spacing="16">
                <HBox spacing="32">
                    <VBox spacing="4">
                        <Label text="MÃ ĐƠN" styleClass="form-label"/>
                        <Label fx:id="lblSiteOrderId" style="-fx-text-fill: #8892A8; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="SITE" styleClass="form-label"/>
                        <Label fx:id="lblSite" style="-fx-text-fill: #8892A8; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="PHƯƠNG TIỆN VẬN CHUYỂN" styleClass="form-label"/>
                    <ComboBox fx:id="cmbMeans" maxWidth="Infinity"
                              style="-fx-background-color: #1C2030; -fx-border-color: #252A3A;
                                     -fx-border-radius: 8px; -fx-background-radius: 8px;
                                     -fx-text-fill: #E8ECF5;"/>
                    <Label fx:id="lblArrivalPreview"
                           style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                </VBox>

                <Label fx:id="lblWarning" style="-fx-text-fill: #F59E0B; -fx-font-size: 12px;"
                       visible="false" managed="false" wrapText="true"/>
                <Label fx:id="lblError" styleClass="form-error" wrapText="true"
                       visible="false" managed="false"/>

                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Hủy" styleClass="btn-ghost" onAction="#goSiteOrders"/>
                    <Button text="💾 Lưu thay đổi" styleClass="btn-primary" onAction="#handleSave"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>