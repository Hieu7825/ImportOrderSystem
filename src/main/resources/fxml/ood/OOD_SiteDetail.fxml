<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.controller.ood.OOD_SiteDetailController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item" maxWidth="Infinity" onAction="#goDashboard"/>
            <Button text="📋  Yêu cầu nhập hàng" styleClass="nav-item" maxWidth="Infinity" onAction="#goOrderRequests"/>
            <Button text="📦  Đơn hàng" styleClass="nav-item" maxWidth="Infinity" onAction="#goSiteOrders"/>
            <Button text="⚠  Yêu cầu hủy" styleClass="nav-item" maxWidth="Infinity" onAction="#goCancelRequests"/>
            <Button text="🏭  Quản lý Site" styleClass="nav-item, nav-item-active" maxWidth="Infinity" onAction="#goSites"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="ĐẶT HÀNG QUỐC TẾ" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 32;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Quay lại" styleClass="btn-ghost" onAction="#goSites"/>
                <Label text="Thông tin Site (Chỉ xem)"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 20px; -fx-font-weight: 700;"
                       HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnDeactivate" text="⛔ Ngừng liên doanh"
                        styleClass="btn-danger" onAction="#handleDeactivate"/>
            </HBox>

            <!-- Thông báo read-only -->
            <Label text="ℹ Thông tin site do SITE tự cập nhật. OOD chỉ có thể xem và ngừng liên doanh."
                   style="-fx-text-fill: #4A5368; -fx-font-size: 12px;
                          -fx-background-color: rgba(79,110,247,0.06);
                          -fx-background-radius: 6px; -fx-padding: 8 12;"/>

            <!-- Thông tin cơ bản (read-only) -->
            <VBox styleClass="stat-card" spacing="16">
                <Label text="Thông tin cơ bản"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                <HBox spacing="32">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="MÃ SITE" styleClass="form-label"/>
                        <Label fx:id="lblSiteCode"
                               style="-fx-text-fill: #E8ECF5; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="TRẠNG THÁI LIÊN DOANH" styleClass="form-label"/>
                        <Label fx:id="lblPartnerStatus"
                               style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="TRẠNG THÁI HỆ THỐNG" styleClass="form-label"/>
                        <Label fx:id="lblStatus"
                               style="-fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </VBox>
                </HBox>
                <HBox spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="TÊN SITE" styleClass="form-label"/>
                        <Label fx:id="lblSiteName"
                               style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="QUỐC GIA" styleClass="form-label"/>
                        <Label fx:id="lblCountry"
                               style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>
                <HBox spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="EMAIL LIÊN HỆ" styleClass="form-label"/>
                        <Label fx:id="lblEmail"
                               style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="SỐ NGÀY TÀU" styleClass="form-label"/>
                        <Label fx:id="lblShipDays"
                               style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="SỐ NGÀY HÀNG KHÔNG" styleClass="form-label"/>
                        <Label fx:id="lblAirDays"
                               style="-fx-text-fill: #E8ECF5; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Catalog (read-only) -->
            <VBox styleClass="stat-card" spacing="12">
                <Label text="Mặt hàng kinh doanh (do SITE tự cập nhật)"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                <ListView fx:id="lstCatalog" prefHeight="180"
                          style="-fx-background-color: #0D0F14; -fx-border-color: #252A3A;
                                 -fx-border-radius: 8px; -fx-background-radius: 8px;"/>
            </VBox>

        </VBox>
    </center>
</BorderPane>
