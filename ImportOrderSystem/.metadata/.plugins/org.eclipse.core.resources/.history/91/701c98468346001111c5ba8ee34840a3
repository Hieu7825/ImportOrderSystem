    // ─────────────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────────────
    private static void createUser(UserRepository repo, String username,
            String password, String role, String fullName, String siteCode, boolean active) {
        User u = new User();
        u.setUsername(username);
        u.setPasswordHash(AuthService.hashPassword(password));
        u.setRole(role);
        u.setFullName(fullName);
        u.setSiteCode(siteCode);
        u.setActive(active);
        u.setCreatedAt(LocalDateTime.now());
        u.setUpdatedAt(LocalDateTime.now());
        repo.save(u);
        System.out.println("[Seeder] Created user: " + username + " (" + role + ")" + (active ? "" : " [LOCKED]"));
    }

    private static void createMerch(MerchandiseRepository repo, String code,
            String name, String unit, String category) {
        Merchandise m = new Merchandise();
        m.setItemCode(code);
        m.setItemName(name);
        m.setDefaultUnit(unit);
        m.setCategory(category);
        m.setActive(true);
        m.setCreatedBy("admin");
        m.setCreatedAt(LocalDateTime.now());
        m.setUpdatedAt(LocalDateTime.now());
        repo.save(m);
        System.out.println("[Seeder] Created merchandise: " + code + " - " + name);
    }

    private static void createSite(SiteRepository repo, String code, String name,
            String country, String email, int ship, int air, List<String> catalog) {
        SiteInfo s = new SiteInfo();
        s.setSiteCode(code);
        s.setSiteName(name);
        s.setCountry(country);
        s.setContactEmail(email);
        s.setShipDays(ship);
        s.setAirDays(air);
        s.setCatalogItems(catalog);
        s.setStatus("ACTIVE");
        s.setUpdatedAt(LocalDateTime.now());
        repo.save(s);
        System.out.println("[Seeder] Created site: " + code + " - " + name + " (" + country + ")");
    }
