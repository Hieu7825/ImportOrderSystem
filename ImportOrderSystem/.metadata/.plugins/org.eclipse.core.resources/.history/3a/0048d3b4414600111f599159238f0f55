/* ===== IMPORT FONT ===== */
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');

/* ===== ROOT VARIABLES ===== */
.root {
	-fx-font-family: "DM Sans";
	    -fx-font-size: 14px;
	    -fx-background-color: #0D0F14;
}

/* ===== SCENE / WINDOW ===== */
.scene-root {
    -fx-background-color: #0D0F14;
}

/* ===== SIDEBAR ===== */
.sidebar {
    -fx-background-color: #0D0F14;
    -fx-border-color: transparent #252A3A transparent transparent;
    -fx-border-width: 0 1 0 0;
    -fx-min-width: 220px;
    -fx-max-width: 220px;
}

.sidebar-logo {
    -fx-text-fill: #E8ECF5;
    -fx-font-size: 16px;
    -fx-font-weight: bold;
    -fx-padding: 20 16 10 16;
}

.nav-item {
    -fx-background-color: transparent;
    -fx-text-fill: #8892A8;
    -fx-font-size: 13px;
    -fx-padding: 10 16 10 16;
    -fx-cursor: hand;
    -fx-alignment: CENTER_LEFT;
    -fx-max-width: infinity;
    -fx-background-radius: 6px;
    -fx-border-radius: 6px;
}

.nav-item:hover {
    -fx-background-color: #1C2030;
    -fx-text-fill: #E8ECF5;
}

.nav-item-active {
    -fx-background-color: rgba(79, 110, 247, 0.12);
    -fx-text-fill: #4F6EF7;
    -fx-font-weight: bold;
}

.nav-divider {
    -fx-background-color: #252A3A;
    -fx-min-height: 1px;
    -fx-max-height: 1px;
    -fx-margin: 8 0;
}

.sidebar-user-name {
    -fx-text-fill: #E8ECF5;
    -fx-font-size: 13px;
    -fx-font-weight: 600;
}

.sidebar-user-role {
    -fx-text-fill: #8892A8;
    -fx-font-size: 11px;
}

.btn-logout {
    -fx-background-color: transparent;
    -fx-text-fill: #EF4444;
    -fx-font-size: 12px;
    -fx-padding: 6 12;
    -fx-cursor: hand;
    -fx-border-color: rgba(239, 68, 68, 0.3);
    -fx-border-radius: 6px;
    -fx-background-radius: 6px;
}

.btn-logout:hover {
    -fx-background-color: rgba(239, 68, 68, 0.1);
}

/* ===== TOPBAR ===== */
.topbar {
    -fx-background-color: #13161E;
    -fx-border-color: transparent transparent #252A3A transparent;
    -fx-border-width: 0 0 1 0;
    -fx-padding: 0 24;
    -fx-min-height: 56px;
    -fx-max-height: 56px;
}

.topbar-title {
    -fx-text-fill: #E8ECF5;
    -fx-font-size: 18px;
    -fx-font-weight: 700;
}

/* ===== MAIN CONTENT ===== */
.main-content {
    -fx-background-color: #0D0F14;
    -fx-padding: 24;
}

/* ===== STAT CARDS ===== */
.stat-card {
    -fx-background-color: #13161E;
    -fx-border-color: #252A3A;
    -fx-border-radius: 10px;
    -fx-background-radius: 10px;
    -fx-padding: 20;
}

.stat-card-value {
    -fx-text-fill: #E8ECF5;
    -fx-font-size: 28px;
    -fx-font-weight: 700;
}

.stat-card-label {
    -fx-text-fill: #8892A8;
    -fx-font-size: 12px;
}

/* ===== BUTTONS ===== */
.btn-primary {
    -fx-background-color: #4F6EF7;
    -fx-text-fill: white;
    -fx-font-size: 13px;
    -fx-font-weight: 600;
    -fx-padding: 10 20;
    -fx-background-radius: 8px;
    -fx-border-radius: 8px;
    -fx-cursor: hand;
}

.btn-primary:hover {
    -fx-background-color: #6B84FF;
}

.btn-ghost {
    -fx-background-color: transparent;
    -fx-text-fill: #8892A8;
    -fx-font-size: 13px;
    -fx-padding: 10 20;
    -fx-background-radius: 8px;
    -fx-border-radius: 8px;
    -fx-border-color: #252A3A;
    -fx-border-width: 1px;
    -fx-cursor: hand;
}

.btn-ghost:hover {
    -fx-border-color: #4F6EF7;
    -fx-text-fill: #4F6EF7;
}

.btn-danger {
    -fx-background-color: rgba(239, 68, 68, 0.12);
    -fx-text-fill: #EF4444;
    -fx-font-size: 13px;
    -fx-padding: 10 20;
    -fx-background-radius: 8px;
    -fx-border-radius: 8px;
    -fx-border-color: rgba(239, 68, 68, 0.3);
    -fx-border-width: 1px;
    -fx-cursor: hand;
}

.btn-danger:hover {
    -fx-background-color: rgba(239, 68, 68, 0.2);
}

.btn-success {
    -fx-background-color: rgba(34, 197, 94, 0.12);
    -fx-text-fill: #22C55E;
    -fx-padding: 10 20;
    -fx-background-radius: 8px;
    -fx-border-radius: 8px;
    -fx-border-color: rgba(34, 197, 94, 0.3);
    -fx-border-width: 1px;
    -fx-cursor: hand;
}

/* ===== TABLE VIEW ===== */
.table-view {
    -fx-background-color: #13161E;
    -fx-border-color: #252A3A;
    -fx-border-radius: 10px;
    -fx-background-radius: 10px;
}

.table-view .column-header-background {
    -fx-background-color: #1C2030;
    -fx-background-radius: 10px 10px 0 0;
}

.table-view .column-header {
    -fx-background-color: transparent;
    -fx-text-fill: #8892A8;
    -fx-font-size: 11px;
    -fx-font-weight: 600;
    -fx-padding: 12 16;
}

.table-row-cell {
    -fx-background-color: transparent;
    -fx-border-color: transparent transparent #1C2030 transparent;
    -fx-border-width: 0 0 1 0;
    -fx-text-fill: #E8ECF5;
    -fx-font-size: 13px;
    -fx-padding: 0 16;
}

.table-row-cell:hover {
    -fx-background-color: #222840;
}

.table-row-cell:selected {
    -fx-background-color: rgba(79, 110, 247, 0.15);
}

.table-row-cell .table-cell {
    -fx-text-fill: #E8ECF5;
    -fx-padding: 12 8;
}

/* Row màu theo status */
.row-warning {
    -fx-background-color: rgba(245, 158, 11, 0.08);
}

.row-danger {
    -fx-background-color: rgba(239, 68, 68, 0.08);
}

.row-success {
    -fx-background-color: rgba(34, 197, 94, 0.05);
}

/* ===== BADGES / TAGS ===== */
.badge {
    -fx-padding: 3 10;
    -fx-background-radius: 20px;
    -fx-font-size: 11px;
    -fx-font-weight: 600;
}

.badge-pending {
    -fx-background-color: rgba(245, 158, 11, 0.15);
    -fx-text-fill: #F59E0B;
}

.badge-processing {
    -fx-background-color: rgba(56, 189, 248, 0.15);
    -fx-text-fill: #38BDF8;
}

.badge-completed {
    -fx-background-color: rgba(34, 197, 94, 0.15);
    -fx-text-fill: #22C55E;
}

.badge-cancelled {
    -fx-background-color: rgba(74, 83, 104, 0.3);
    -fx-text-fill: #8892A8;
}

.badge-sent {
    -fx-background-color: rgba(56, 189, 248, 0.15);
    -fx-text-fill: #38BDF8;
}

.badge-received {
    -fx-background-color: rgba(34, 197, 94, 0.15);
    -fx-text-fill: #22C55E;
}

.badge-discrepancy {
    -fx-background-color: rgba(239, 68, 68, 0.15);
    -fx-text-fill: #EF4444;
}

.tag-ship {
    -fx-background-color: rgba(34, 197, 94, 0.12);
    -fx-text-fill: #22C55E;
    -fx-padding: 2 8;
    -fx-background-radius: 4px;
    -fx-font-size: 11px;
}

.tag-air {
    -fx-background-color: rgba(56, 189, 248, 0.12);
    -fx-text-fill: #38BDF8;
    -fx-padding: 2 8;
    -fx-background-radius: 4px;
    -fx-font-size: 11px;
}

/* ===== FORM FIELDS ===== */
.text-field, .text-area, .combo-box {
    -fx-background-color: #1C2030;
    -fx-text-fill: #E8ECF5;
    -fx-prompt-text-fill: #4A5368;
    -fx-border-color: #252A3A;
    -fx-border-radius: 8px;
    -fx-background-radius: 8px;
    -fx-padding: 10 14;
    -fx-font-size: 13px;
}

.text-field:focused, .text-area:focused, .combo-box:focused {
    -fx-border-color: #4F6EF7;
}

.form-label {
    -fx-text-fill: #8892A8;
    -fx-font-size: 12px;
    -fx-font-weight: 600;
}

.form-error {
    -fx-text-fill: #EF4444;
    -fx-font-size: 11px;
}

/* ===== SECTION TITLE ===== */
.section-title {
    -fx-text-fill: #E8ECF5;
    -fx-font-size: 16px;
    -fx-font-weight: 700;
}

.section-subtitle {
    -fx-text-fill: #8892A8;
    -fx-font-size: 13px;
}

/* ===== SCROLL BAR ===== */
.scroll-bar {
    -fx-background-color: transparent;
}

.scroll-bar .thumb {
    -fx-background-color: #252A3A;
    -fx-background-radius: 4px;
}

.scroll-bar .thumb:hover {
    -fx-background-color: #4A5368;
}

/* ===== DATE PICKER ===== */
.date-picker {
    -fx-background-color: #1C2030;
    -fx-border-color: #252A3A;
    -fx-border-radius: 8px;
    -fx-background-radius: 8px;
}

.date-picker .text-field {
    -fx-border-color: transparent;
}