<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.controller.admin.Admin_UserFormController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#goDashboard"/>
            <Button text="👥  Quản lý tài khoản" styleClass="nav-item, nav-item-active"
                    maxWidth="Infinity" onAction="#goUserList"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="ADMIN" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout"
                    maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- MAIN -->
    <center>
        <VBox spacing="24" style="-fx-padding: 32;" maxWidth="600">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Quay lại" styleClass="btn-ghost" onAction="#goUserList"/>
                <Label fx:id="lblTitle" text="Tạo tài khoản mới"
                       style="-fx-text-fill: #E8ECF5; -fx-font-size: 20px; -fx-font-weight: 700;"/>
            </HBox>

            <!-- Form Card -->
            <VBox styleClass="stat-card" spacing="20">

                <!-- Username -->
                <VBox spacing="6">
                    <Label text="USERNAME *" styleClass="form-label"/>
                    <TextField fx:id="txtUsername" promptText="Nhập username..."
                               styleClass="text-field"/>
                    <Label fx:id="lblUsernameErr" styleClass="form-error"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Full Name -->
                <VBox spacing="6">
                    <Label text="HỌ TÊN *" styleClass="form-label"/>
                    <TextField fx:id="txtFullName" promptText="Nhập họ tên đầy đủ..."
                               styleClass="text-field"/>
                    <Label fx:id="lblFullNameErr" styleClass="form-error"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Role -->
                <VBox spacing="6">
                    <Label text="ROLE *" styleClass="form-label"/>
                    <ComboBox fx:id="cmbRole" promptText="Chọn role..."
                              maxWidth="Infinity"
                              style="-fx-background-color: #1C2030; -fx-border-color: #252A3A;
                                     -fx-border-radius: 8px; -fx-background-radius: 8px;
                                     -fx-text-fill: #E8ECF5;"
                              onAction="#handleRoleChange"/>
                    <Label fx:id="lblRoleErr" styleClass="form-error"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Site Code (chỉ hiện khi role = SITE) -->
                <VBox fx:id="vboxSiteCode" spacing="6" visible="false" managed="false">
                    <Label text="SITE CODE *" styleClass="form-label"/>
                    <ComboBox fx:id="cmbSiteCode" promptText="Chọn site..."
                              maxWidth="Infinity"
                              style="-fx-background-color: #1C2030; -fx-border-color: #252A3A;
                                     -fx-border-radius: 8px; -fx-background-radius: 8px;
                                     -fx-text-fill: #E8ECF5;"/>
                    <Label fx:id="lblSiteErr" styleClass="form-error"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="6">
                    <Label fx:id="lblPasswordLabel" text="MẬT KHẨU TẠM *"
                           styleClass="form-label"/>
                    <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu tạm (min 8 ký tự)..."
                                  styleClass="text-field"/>
                    <Label fx:id="lblPasswordErr" styleClass="form-error"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Error chung -->
                <Label fx:id="lblError" styleClass="form-error"
                       wrapText="true" visible="false" managed="false"
                       style="-fx-background-color: rgba(239,68,68,0.1);
                              -fx-background-radius: 6px; -fx-padding: 8 12;"/>

                <!-- Buttons -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Hủy" styleClass="btn-ghost" onAction="#goUserList"/>
                    <Button fx:id="btnSave" text="Tạo tài khoản"
                            styleClass="btn-primary" onAction="#handleSave"/>
                </HBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>