<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.importorder.controller.sd.SD_DashboardController"
            stylesheets="@../../css/global.css"
            style="-fx-background-color: #0D0F14;">
    <left>
        <VBox styleClass="sidebar" spacing="4" style="-fx-padding: 20 12;">
            <Label text="📦 Import Order" styleClass="sidebar-logo"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Button text="⬛  Tổng quan" styleClass="nav-item, nav-item-active"
                    maxWidth="Infinity"/>
            <Button text="📋  Yêu cầu nhập hàng" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#goOrderList"/>
            <Button text="📦  Danh sách mặt hàng" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#goMerchandise"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #252A3A;"/>
            <Label fx:id="lblUserName" styleClass="sidebar-user-name"/>
            <Label text="BỘ PHẬN BÁN HÀNG" styleClass="sidebar-user-role"/>
            <Button text="Đăng xuất" styleClass="btn-logout"
                    maxWidth="Infinity" onAction="#handleLogout"/>
            <Button text="🔑 Đổi mật khẩu" styleClass="btn-ghost"
       				 maxWidth="Infinity" onAction="#handleChangePassword"
       				 style="-fx-font-size: 12px;"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="24" style="-fx-padding: 32;">
            <Label text="Tổng quan"
                   style="-fx-text-fill: #E8ECF5; -fx-font-size: 22px; -fx-font-weight: 700;"/>
            <HBox spacing="16">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Chờ xử lý" styleClass="stat-card-label"/>
                    <Label fx:id="lblPending" text="0" styleClass="stat-card-value"
                           style="-fx-text-fill: #F59E0B;"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Đang xử lý" styleClass="stat-card-label"/>
                    <Label fx:id="lblProcessing" text="0" styleClass="stat-card-value"
                           style="-fx-text-fill: #38BDF8;"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Hoàn thành" styleClass="stat-card-label"/>
                    <Label fx:id="lblCompleted" text="0" styleClass="stat-card-value"
                           style="-fx-text-fill: #22C55E;"/>
                </VBox>
            </HBox>
            <HBox spacing="16">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="12"
                      style="-fx-cursor: hand;" onMouseClicked="#goOrderList">
                    <Label text="📋  Yêu cầu nhập hàng"
                           style="-fx-text-fill: #E8ECF5; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                    <Label text="Tạo và quản lý các yêu cầu nhập hàng"
                           style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="12"
                      style="-fx-cursor: hand;" onMouseClicked="#goMerchandise">
                    <Label text="📦  Danh sách mặt hàng"
                           style="-fx-text-fill: #E8ECF5; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                    <Label text="Quản lý danh mục mặt hàng hệ thống"
                           style="-fx-text-fill: #8892A8; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>